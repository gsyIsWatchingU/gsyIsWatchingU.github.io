{
  "schema_version": "1.0",
  "name": "squidward-house-space-config",
  "description": "章鱼哥屋统一空间配置（唯一权威）。后续家具/装配/预览子代理一律读本文件，不要自行推断坐标。",
  "updated": "2026-10-12",

  "coordinate_system": {
    "source": "Blender 源工程 Z-up",
    "axes_source": {
      "X": "右为正（+X = 建筑右侧，螺旋楼梯所在侧）",
      "Y": "+Y 为后，-Y 为前（摩艾脸/正门朝向 -Y）",
      "Z": "上为正，地面 Z=0"
    },
    "glb_export": "GLB 导出 Y-up、+Z 朝前",
    "axis_conversion": {
      "rule": "Blender(X,Y,Z) -> glTF(X, -Z, Y)，由 Blender glTF 导出器自动完成（旋转 -90° about X）",
      "glTF_X": "= Blender X（右）",
      "glTF_Y": "= Blender Z（上）",
      "glTF_Z": "= -Blender Y（前）",
      "note": "只做一次转换。模型正面在 Blender 中朝 -Y，导出后在 glTF 中朝 +Z（朝前），符合约定。"
    },
    "units": "米",
    "origin": "建筑平面中心 (X=0,Y=0)，地面 Z=0"
  },

  "overall": {
    "bounding_box_blender": {
      "min": [-1.6, -1.55, 0.0],
      "max": [1.6, 1.55, 4.65],
      "note": "含壳厚与圆弧顶；基础板底对齐 z=0（落地）；剖切开口在 -Y 前侧"
    },
    "shell": {
      "base_outer_radius": 1.55,
      "body_top_outer_radius": 1.32,
      "body_top_z": 3.9,
      "cap": "Z=3.9 以上为椭圆圆弧石壳帽，收至 Z=4.65 apex，非球形穹顶",
      "apex_z": 4.65,
      "wall_thickness": 0.20,
      "inner_radius_base": 1.35
    },
    "default_camera": {
      "view": "从剖切开口前侧（偏左前）竖直看向建筑，保证完整看到四层",
      "blender_camera_location": [-3.2, -4.6, 2.6],
      "blender_camera_target": [0.0, 0.0, 2.25],
