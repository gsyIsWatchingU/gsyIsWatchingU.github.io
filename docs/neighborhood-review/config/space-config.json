      "glTF_camera_location": [-3.2, 2.6, 4.6],
      "glTF_camera_target": [0.0, 2.25, 0.0],
      "note": "目标点 Z=2.25 为四层中点；相机高度略俯视以同时看到地面与顶层浴室。"
    }
  },

